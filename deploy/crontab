# Polymarket Desk na VPS: instale com `crontab deploy/crontab` depois de ajustar DESK_HOME e PATH.
PATH=/home/desk/.local/bin:/usr/local/bin:/usr/bin:/bin
DESK_HOME=/home/desk/polymarket-desk
# flock: never two cycles at once; timeout: a hung cycle dies before the next one (the Windows task has the same 30 min cap)
*/10 * * * * cd $DESK_HOME && flock -n state/cron.flock timeout 25m .venv/bin/python -m desk cycle >> state/cron.log 2>&1
*/3 * * * * cd $DESK_HOME && flock -n state/memes.flock timeout 25m .venv/bin/python -m desk memes >> state/cron.log 2>&1
0 9 * * * cd $DESK_HOME && .venv/bin/python -m desk monthly >> state/cron.log 2>&1
