# Copie para .env (o .env nunca vai para o git). Nunca cole estes valores em chats.

# --- Modo real (deixe vazio enquanto estiver em paper) ---
# Chave privada da carteira DEDICADA ao robô (só com a banca dentro).
POLY_PRIVATE_KEY=
# Endereço da carteira Polymarket que guarda o saldo (0x..., aparece no perfil/depósito).
# Vazio = Deposit Wallet padrão da chave.
POLY_WALLET=
# Segunda trava do modo real: precisa ser exatamente I_UNDERSTAND
DESK_LIVE=

# --- Avisos pelo Telegram (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Memecoins na Solana (modo real; deixe vazio enquanto estiver em paper) ---
# Chave privada base58 de uma carteira Solana DEDICADA ao agente (só com a banca das memecoins dentro).
MEMES_PRIVATE_KEY=
# Segunda trava do modo real das memecoins: precisa ser exatamente I_UNDERSTAND
MEMES_LIVE=
# Opcional: RPC privado (ex.: Helius gratuito). Vazio = RPC público da Solana.
MEMES_RPC_URL=
